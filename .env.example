# ── Sanity ─────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values from your Sanity project
# (sanity.io → your project → API / project settings). The PROJECT_ID and
# DATASET are safe to expose (read-only public content); the WRITE TOKEN is
# server-only and must never be committed.

NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"

# Only needed to run the one-time content migration script (scripts/migrate.ts).
# Create it at: Sanity project → API → Tokens → "Add API token" → Editor role.
SANITY_API_WRITE_TOKEN=""

# ── WhatsApp ───────────────────────────────────────────────────────────────
# Business number used for order/enquiry links, in full international format:
# country code + number, digits only (no '+', spaces or dashes). Public.
NEXT_PUBLIC_WHATSAPP_NUMBER="919249041474"

# ── Site URL (SEO) ─────────────────────────────────────────────────────────
# Absolute base URL of the storefront, used for canonical tags, Open Graph /
# social cards, the sitemap and structured data. Public. Optional — defaults to
# https://www.amritararituals.com when unset. Use the PRIMARY domain exactly as
# served (the apex redirects to www, so www is primary). Set per environment so
# those tags point at the right host. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://www.amritararituals.com"

# ── Feature flags ──────────────────────────────────────────────────────────
# Stone Décor line (one flat section: car/wall hangings, figurines). Public.
# Hidden unless set to the exact string "true". Set "true" (and redeploy) to
# keep the feature live; set "false" to hide it everywhere again.
NEXT_PUBLIC_DECOR_ENABLED="true"

# ── Analytics (Google Analytics 4) ─────────────────────────────────────────
# GA4 Measurement ID (Analytics → Admin → Data streams → your web stream).
# Leave blank to disable analytics entirely (e.g. local dev). Public.
NEXT_PUBLIC_GA_ID=""
